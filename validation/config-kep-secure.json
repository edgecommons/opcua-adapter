{
  "tags": { "appId": "smoke", "site": "lab", "shop": "s1", "line": "l1" },
  "logging": { "level": "INFO" },
  "metricEmission": {
    "target": "messaging",
    "targetConfig": { "topic": "metrics/{ThingName}/{ComponentName}" }
  },
  "component": {
    "global": {
      "defaults": { "publishIntervalMs": 1000, "samplingRateMs": 500, "queueSize": 10 },
      "healthThresholds": { "staleTagSecs": 30 }
    },
    "instances": [
      {
        "id": "kep1",
        "adapter": "opcua",
        "connection": {
          "endpoint": "opc.tcp://192.168.1.180:49320",
          "securityPolicy": "Basic256Sha256",
          "messageMode": "SignAndEncrypt",
          "clientCertificate": { "source": "file", "certPath": "validation/certs/client_cert.pem", "keyPath": "validation/certs/client_key.pem" },
          "trust": {
            "pkiDir": "validation/pki/{InstanceId}",
            "serverCertificate": { "source": "file", "path": "validation/certs/kep_server_cert.pem" }
          }
        },
        "publish": { "topic": "southbound/{site}/{ComponentName}/{InstanceId}/{tagId}", "batchMs": 1000 },
        "write": { "enabled": true, "topic": "southbound/{ComponentName}/{InstanceId}/write" },
        "read": { "topic": "southbound/{ComponentName}/{InstanceId}/read" },
        "subscriptions": [
          {
            "id": "system-clock",
            "include": [
              { "namespaceUri": "Kepware Server", "match": "^_System\\._Time.*", "samplingRateMs": 500, "queueSize": 10,
                "deadband": { "type": "None", "value": 0.0 } }
            ],
            "exclude": []
          }
        ]
      }
    ]
  }
}
