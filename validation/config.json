{
  "tags": { "appId": "smoke", "site": "lab", "shop": "s1", "line": "l1" },
  "logging": { "level": "INFO" },
  "metricEmission": {
    "target": "messaging",
    "targetConfig": { "topic": "metrics/{ThingName}/{ComponentName}" }
  },
  "component": {
    "global": {
      "defaults": { "publishIntervalMs": 500, "samplingRateMs": 250, "queueSize": 100 },
      "healthThresholds": { "staleTagSecs": 30 }
    },
    "instances": [
      {
        "id": "sim1",
        "adapter": "opcua",
        "connection": { "endpoint": "opc.tcp://localhost:4840/", "securityPolicy": "None" },
        "publish": { "topic": "southbound/{site}/{ComponentName}/{InstanceId}/{tagId}", "batchMs": 500 },
        "write": { "enabled": true, "topic": "southbound/{ComponentName}/{InstanceId}/write" },
        "read": { "topic": "southbound/{ComponentName}/{InstanceId}/read" },
        "subscriptions": [
          {
            "id": "sines",
            "include": [
              { "namespace": 2, "match": "Sine.*", "samplingRateMs": 250, "queueSize": 50,
                "deadband": { "type": "None", "value": 0.0 } }
            ],
            "exclude": []
          }
        ]
      }
    ]
  }
}
