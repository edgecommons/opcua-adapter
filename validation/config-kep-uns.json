{
  "tags": { "appId": "smoke" },
  "logging": { "level": "INFO" },
  "hierarchy": { "levels": ["site", "shop", "line", "device"] },
  "identity": { "site": "lab", "shop": "s1", "line": "l1" },
  "metricEmission": { "target": "log", "targetConfig": { "logFileName": "kep-metrics.log" } },
  "component": {
    "token": "opcua-adapter",
    "global": {
      "defaults": { "publishIntervalMs": 1000, "samplingRateMs": 500, "queueSize": 10 },
      "healthThresholds": { "staleSignalSecs": 30 },
      "browse": { "maxNodes": 50000, "maxDepth": 32 },
      "limits": { "maxReadTargets": 1000, "commandTimeoutMs": 15000, "chunkSize": 100 }
    },
    "instances": [
      {
        "id": "kep1",
        "connection": {
          "endpoint": "opc.tcp://192.168.1.180:49320",
          "securityPolicy": "None",
          "messageMode": "None"
        },
        "publish": { "batchMs": 1000 },
        "writes": { "allow": ["nsu=Kepware Server;s=EdgeCommonsTest.Device1.Setpoint"] },
        "subscriptions": [
          {
            "id": "system-clock",
            "include": [
              {
                "namespaceUri": "Kepware Server",
                "match": "^_System\\._Time.*",
                "samplingRateMs": 500,
                "queueSize": 10,
                "deadband": { "type": "None", "value": 0.0 }
              }
            ],
            "exclude": []
          }
        ]
      }
    ]
  }
}
